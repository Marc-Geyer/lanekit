# ─────────────────────────────────────────────────────────────────────────────
# LaneKit – Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Branding ──────────────────────────────────────────────────────────────────
# Your club / organisation name – shown in the navbar and page titles.
ORGANISATION_NAME=My Swimming Club

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=False

# Your public domain (used for CSRF protection and SSL certificate).
# No https:// prefix, no trailing slash.
DOMAIN=lanekit.example.com

# Optional: additional domains that redirect (301) to DOMAIN, space separated.
# They are added to the same Let's Encrypt certificate. Their DNS must point here.
# ALIAS_DOMAINS=old-name.example.com lanekit.example.org
ALIAS_DOMAINS=

# Hostnames Django accepts, space separated. Must contain DOMAIN.
ALLOWED_HOSTS=lanekit.example.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=lanekit
DB_USER=lanekit
DB_PASSWORD=change-me-strong-db-password

# ── Redis (WebSocket channel layer) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── First-boot superuser (created automatically on first `docker compose up`) ─
# Remove these lines after the first start – they are not needed again.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong-admin-password

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
# Required for account activation and e-mail change verification.
# Port 587 + EMAIL_USE_TLS=True (STARTTLS)  or  port 465 + EMAIL_USE_SSL=True.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=change-me-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Sender address (many providers require this to match EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=LaneKit <you@example.com>

# ── Certbot / Let's Encrypt ───────────────────────────────────────────────────
# E-mail address for expiry notifications from Let's Encrypt.
CERTBOT_EMAIL=you@example.com

# Set to "--staging" to test against the Let's Encrypt staging server
# (unlimited requests, but browsers will show a warning).
# Set to "" (empty) for a real certificate.
CERTBOT_STAGING_FLAG=--staging
